{
  "name": "modelbuilder-workbench",
  "displayName": "Protomire Workbench",
  "description": "Permanent model lifecycle workbench for the Protomire Code - OSS distribution.",
  "version": "0.1.0",
  "publisher": "modelbuilder",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:modelrecipe"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read and author recipes. Execution and connection changes require a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "modelbuilder.openWorkbench",
        "title": "Protomire: Open Model Workbench"
      },
      {
        "command": "modelbuilder.configureConnection",
        "title": "Protomire: Configure Service Connection"
      },
      {
        "command": "modelbuilder.createProject",
        "title": "Protomire: New Model Project"
      },
      {
        "command": "modelbuilder.refresh",
        "title": "Protomire: Refresh Model Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "modelbuilder.openRecipeSource",
        "title": "Protomire: Open Recipe JSON Source"
      },
      {
        "command": "modelbuilder.closeProject",
        "title": "Protomire: Close Model Project"
      },
      {
        "command": "modelbuilder.importRecipeBundle",
        "title": "Protomire: Import Recipe\u2026",
        "enablement": "modelbuilder.projectOpen"
      },
      {
        "command": "modelbuilder.exportRecipeBundle",
        "title": "Protomire: Export Recipe\u2026",
        "enablement": "modelbuilder.projectOpen"
      },
      {
        "command": "modelbuilder.setupAssistant",
        "title": "Protomire: Set Up Optional Coding Tool"
      },
      {
        "command": "modelbuilder.discoverPrivateRecipe",
        "title": "Protomire: Discover Private Recipes\u2026",
        "enablement": "modelbuilder.projectOpen"
      },
      {
        "command": "modelbuilder.publishPrivateRecipe",
        "title": "Protomire: Publish Recipe Privately\u2026",
        "enablement": "modelbuilder.projectOpen"
      },
      {
        "command": "modelbuilder.registerProjectSource",
        "title": "Protomire: Register Trusted Project Source",
        "enablement": "modelbuilder.projectOpen"
      },
      {
        "command": "modelbuilder.openHub",
        "title": "Protomire: Open Hugging Face Repository",
        "enablement": "modelbuilder.projectOpen",
        "icon": "$(cloud)"
      },
      {
        "command": "modelbuilder.hubStage",
        "title": "Protomire: Stage Hub File",
        "enablement": "modelbuilder.projectOpen",
        "icon": "$(add)"
      },
      {
        "command": "modelbuilder.hubUnstage",
        "title": "Protomire: Unstage Hub File",
        "enablement": "modelbuilder.projectOpen",
        "icon": "$(remove)"
      },
      {
        "command": "modelbuilder.hubPublishStaged",
        "title": "Protomire: Preview Staged Hub Publication",
        "enablement": "modelbuilder.projectOpen",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "modelbuilder.reviewAgentRequests",
        "title": "Protomire: Review Agent Requests"
      },
      {
        "command": "modelbuilder.configureHub",
        "title": "Configure project Hub account and publication folder",
        "category": "Protomire"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modelbuilder",
          "title": "Protomire",
          "icon": "media/model.svg"
        }
      ]
    },
    "views": {
      "modelbuilder": [
        {
          "id": "modelbuilder.explorer",
          "name": "Model Explorer"
        },
        {
          "id": "modelbuilder.hubRepository",
          "name": "Hugging Face Repository",
          "when": "modelbuilder.projectOpen"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modelbuilder.explorer",
        "contents": "One model project, one model, one evolving recipe.\n[Open or create model project](command:modelbuilder.openWorkbench)\n[Connect to service](command:modelbuilder.configureConnection)"
      },
      {
        "view": "modelbuilder.hubRepository",
        "contents": "Models and datasets are separate from source Git.\n[Inspect repository and local files](command:modelbuilder.openHub)\nStaging never uploads. Each publication needs an exact approved preview.\n[Configure Hub account and publication folder](command:modelbuilder.configureHub)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "modelbuilder.refresh",
          "when": "view == modelbuilder.explorer",
          "group": "navigation"
        },
        {
          "command": "modelbuilder.openHub",
          "when": "view == modelbuilder.hubRepository",
          "group": "navigation"
        },
        {
          "command": "modelbuilder.hubPublishStaged",
          "when": "view == modelbuilder.hubRepository",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "modelbuilder.hubStage",
          "when": "false"
        },
        {
          "command": "modelbuilder.hubUnstage",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Protomire",
      "properties": {
        "modelbuilder.serviceUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "scope": "machine",
          "description": "Shared operation service. HTTP allowed only on loopback. Tokens are kept in SecretStorage, never settings."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.modelrecipe.json",
        "url": "./schemas/recipe.v0.schema.json"
      }
    ],
    "configurationDefaults": {
      "chat.disableAIFeatures": true,
      "workbench.startupEditor": "none",
      "workbench.secondarySideBar.defaultVisibility": "hidden"
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --out modelbuilder-workbench-0.1.0.vsix",
    "vscode:prepublish": "npm run compile",
    "test:service": "npm run compile && node test/serviceParity.cjs",
    "test:browser": "npm run compile && node test/liveDom.cjs",
    "test:execution-browser": "npm run compile && node test/executionSettingsDom.cjs",
    "test:workspace-http": "npm run compile && node test/typedWorkspaceHttp.cjs",
    "test:workspace-browser": "npm run compile && node test/typedWorkspaceDom.cjs",
    "test:component-http": "npm run compile && node test/componentAuthoringHttp.cjs",
    "test:source-pin-http": "npm run compile && node test/sourcePinHttp.cjs",
    "test:history-http": "npm run compile && node test/recipeHistoryHttp.cjs",
    "test:history-browser": "npm run compile && node test/recipeHistoryDom.cjs",
    "test:research-document-http": "npm run compile && node test/researchDocumentHttp.cjs",
    "test:research-document-browser": "npm run compile && node test/researchDocumentDom.cjs",
    "test:quickstart-http": "npm run compile && node test/newProjectHttp.cjs",
    "test:quickstart-browser": "npm run compile && node test/newProjectDom.cjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  },
  "extensionKind": [
    "ui"
  ]
}
