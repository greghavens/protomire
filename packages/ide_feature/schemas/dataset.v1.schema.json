{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_mode": {
      "enum": [
        "eager",
        "streaming"
      ]
    },
    "benchmark": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "maxLength": 10000,
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "family_policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "families": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "metrics": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "dependentRequired": {
                    "direction": [
                      "max_regression"
                    ],
                    "max_regression": [
                      "direction"
                    ]
                  },
                  "minProperties": 1,
                  "properties": {
                    "direction": {
                      "enum": [
                        "higher",
                        "lower"
                      ]
                    },
                    "max": {
                      "type": "number"
                    },
                    "max_regression": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "maxProperties": 256,
                "propertyNames": {
                  "maxLength": 200,
                  "minLength": 1
                },
                "type": "object"
              },
              "min_eval_support": {
                "minimum": 1,
                "type": "integer"
              },
              "min_exposure": {
                "minimum": 0,
                "type": "integer"
              },
              "min_rows": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "min_rows",
              "min_exposure",
              "min_eval_support"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "mapping": {
          "additionalProperties": false,
          "properties": {
            "field": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "version",
            "field"
          ],
          "type": "object"
        },
        "research_sources": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "modelbuilder.family-policy.v1"
        }
      },
      "required": [
        "schema_version",
        "mapping",
        "families"
      ],
      "type": "object"
    },
    "id_column": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "license": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "lineage": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "parents": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "minLength": 1,
                "type": "string"
              },
              "content_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "rights": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "parent_rights_digests": {
                        "items": {
                          "pattern": "^[0-9a-f]{64}$",
                          "type": "string"
                        },
                        "type": "array",
                        "uniqueItems": true
                      },
                      "schema_version": {
                        "const": "modelbuilder.artifact-rights/v1"
                      },
                      "sources": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "commit": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "license_evidence_digest": {
                              "pattern": "^[0-9a-f]{64}$",
                              "type": "string"
                            },
                            "license_policy_id": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "provider": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "repo_id": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "repo_type": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "provider",
                            "repo_type",
                            "repo_id",
                            "commit",
                            "license_evidence_digest",
                            "license_policy_id"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "unresolved": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "artifact_id": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "reason": {
                              "minLength": 1,
                              "type": "string"
                            }
                          },
                          "required": [
                            "artifact_id",
                            "reason"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "schema_version",
                      "sources",
                      "unresolved",
                      "parent_rights_digests"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "artifact_id",
              "content_digest",
              "rights"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "const": "modelbuilder.generated-lineage/v1"
        }
      },
      "required": [
        "schema_version",
        "content_digest",
        "parents"
      ],
      "type": "object"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 10000,
          "type": "string"
        },
        "retrieved_at": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "source_revision": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "rights": {
      "additionalProperties": false,
      "properties": {
        "parent_rights_digests": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "modelbuilder.artifact-rights/v1"
        },
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "commit": {
                "minLength": 1,
                "type": "string"
              },
              "license_evidence_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "license_policy_id": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "minLength": 1,
                "type": "string"
              },
              "repo_id": {
                "minLength": 1,
                "type": "string"
              },
              "repo_type": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "provider",
              "repo_type",
              "repo_id",
              "commit",
              "license_evidence_digest",
              "license_policy_id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unresolved": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "minLength": 1,
                "type": "string"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "sources",
        "unresolved",
        "parent_rights_digests"
      ],
      "type": "object"
    },
    "row_schema": {
      "type": "object"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "csv",
              "jsonl",
              "parquet"
            ]
          },
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "root_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "root_id",
          "path",
          "format",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    },
    "splits": {
      "items": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "source_ids"
            ]
          },
          {
            "required": [
              "sample_ids"
            ]
          }
        ],
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "train",
              "validation",
              "test",
              "calibration"
            ]
          },
          "sample_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100000,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "source_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 4096,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "role"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "transformations": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "allocation": {
                "enum": [
                  "proportional",
                  "equal"
                ]
              },
              "fields": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 32,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "fraction": {
                "exclusiveMinimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "kind": {
                "const": "rows.sample"
              },
              "max_share_error": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "min_per_stratum": {
                "maximum": 1000000000,
                "minimum": 0,
                "type": "integer"
              },
              "required_strata": {
                "items": {
                  "minProperties": 1,
                  "type": "object"
                },
                "maxItems": 10000,
                "type": "array"
              },
              "seed": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "split_ids": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "version": {
                "const": "1"
              }
            },
            "required": [
              "kind",
              "version",
              "split_ids",
              "fields",
              "fraction",
              "seed",
              "allocation",
              "min_per_stratum",
              "required_strata",
              "max_share_error"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "casefold": {
                "type": "boolean"
              },
              "fields": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 256,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "const": "text.normalize"
              },
              "strip": {
                "type": "boolean"
              },
              "unicode_form": {
                "enum": [
                  "NFC",
                  "NFD",
                  "NFKC",
                  "NFKD"
                ]
              }
            },
            "required": [
              "kind",
              "fields"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "fields": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 256,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "const": "rows.drop_missing"
              }
            },
            "required": [
              "kind",
              "fields"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "fields": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 256,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "const": "rows.deduplicate"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "fields": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 256,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "const": "rows.decontaminate"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "fields": {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 256,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "const": "columns.select"
              }
            },
            "required": [
              "kind",
              "fields"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 32,
      "type": "array"
    }
  },
  "required": [
    "name",
    "benchmark",
    "license",
    "provenance",
    "sources",
    "id_column",
    "row_schema",
    "splits"
  ],
  "type": "object"
}
