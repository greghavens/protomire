{
  "$id": "https://modelbuilder.local/schemas/recipe.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A typed acyclic graph. Import is inert; execution requires separate authorization and isolation.",
  "properties": {
    "bounded_iterations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "max_iterations": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "node_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "state": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "resume_mode": {
                  "const": "warm_start"
                },
                "source_node": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                },
                "source_port": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                },
                "target_node": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                },
                "target_port": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                }
              },
              "required": [
                "source_node",
                "source_port",
                "target_node",
                "target_port"
              ],
              "type": "object"
            },
            "maxItems": 256,
            "type": "array"
          },
          "until": {
            "additionalProperties": false,
            "properties": {
              "equals": {
                "type": "boolean"
              },
              "source_node": {
                "minLength": 1,
                "type": "string"
              },
              "source_port": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source_node",
              "source_port",
              "equals"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "node_ids",
          "max_iterations",
          "state"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "description": {
      "maxLength": 16384,
      "type": "string"
    },
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source_node": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "source_port": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "target_node": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "target_port": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "source_node",
          "source_port",
          "target_node",
          "target_port"
        ],
        "type": "object"
      },
      "maxItems": 16384,
      "type": "array"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "pattern": "^(cpu|mps|mlx-cpu|mlx-metal|cuda:(0|[1-9][0-9]{0,2}))$",
          "type": "string"
        },
        "lock_file": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "mlx_profile": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "oci_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "python": {
          "pattern": "^3\\.\\d{1,2}(\\.\\d{1,2})?$",
          "type": "string"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "python",
        "requirements"
      ],
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    },
    "evidence_links": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution": {
      "additionalProperties": false,
      "description": "Canonical per-run stage scheduling. Omitted settings preserve sequential execution.",
      "properties": {
        "max_parallel_stages": {
          "default": 1,
          "description": "Maximum simultaneously executing independent native stages. Iterations remain sequential barriers; this is not a resource reservation.",
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "external_dependencies": {
      "items": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "revision"
            ]
          },
          {
            "required": [
              "sha256"
            ]
          }
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "dataset",
              "model",
              "checkpoint",
              "source",
              "artifact",
              "environment"
            ]
          },
          "license": {
            "minLength": 1,
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "private": {
            "type": "boolean"
          },
          "redistribution_allowed": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "revision": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "license"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "licenses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "license": {
            "minLength": 1,
            "type": "string"
          },
          "redistribution_allowed": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "scope",
          "license",
          "redistribution_allowed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cache_policy": {
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "component": {
            "additionalProperties": false,
            "properties": {
              "capabilities": {
                "additionalProperties": false,
                "properties": {
                  "checkpoint_events": {
                    "type": "boolean"
                  },
                  "devices": {
                    "items": {
                      "enum": [
                        "cpu",
                        "cuda",
                        "mps",
                        "mlx-cpu",
                        "mlx-metal"
                      ]
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "export_formats": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "frameworks": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "resume_modes": {
                    "items": {
                      "enum": [
                        "exact_state",
                        "warm_start"
                      ]
                    },
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "required": [
                  "resume_modes",
                  "export_formats",
                  "frameworks"
                ],
                "type": "object"
              },
              "description": {
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "parameter_schema": {
                "type": "object"
              },
              "protocol": {
                "const": "modelbuilder.component/v1"
              },
              "role": {
                "enum": [
                  "training",
                  "evaluation",
                  "export",
                  "dataset",
                  "model",
                  "utility"
                ]
              },
              "version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "protocol",
              "role",
              "parameter_schema",
              "capabilities"
            ],
            "type": "object"
          },
          "condition": {
            "additionalProperties": false,
            "properties": {
              "equals": {
                "type": "boolean"
              },
              "source_node": {
                "minLength": 1,
                "type": "string"
              },
              "source_port": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source_node",
              "source_port",
              "equals"
            ],
            "type": "object"
          },
          "environment_ref": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "implementation_ref": {
            "oneOf": [
              {
                "pattern": "^builtin:[a-z][a-z_.]+$",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "dependentRequired": {
                  "path": [
                    "sha256"
                  ],
                  "sha256": [
                    "path"
                  ]
                },
                "properties": {
                  "commit": {
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                    "type": "string"
                  },
                  "entrypoint": {
                    "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*$",
                    "type": "string"
                  },
                  "module": {
                    "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*$",
                    "type": "string"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "module",
                  "entrypoint",
                  "commit"
                ],
                "type": "object"
              }
            ]
          },
          "inputs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "type": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\], -]{0,127}$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "maxItems": 256,
            "type": "array"
          },
          "kind": {
            "enum": [
              "dataset.import",
              "dataset.version.import",
              "dataset.synthetic",
              "dataset.validate",
              "model.initialize",
              "model.train",
              "model.evaluate",
              "model.compare",
              "model.checkpoint",
              "model.export",
              "code.python",
              "component.run",
              "training.kl_anchor"
            ]
          },
          "outputs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "type": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\], -]{0,127}$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "maxItems": 256,
            "type": "array"
          },
          "parameter_schema": {
            "type": "object"
          },
          "parameters": {
            "type": "object"
          },
          "provenance": {
            "type": "object"
          },
          "resource_request": {
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "gpu": {
                "minimum": 0,
                "type": "integer"
              },
              "memory_mb": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [],
            "type": "object"
          },
          "retry": {
            "additionalProperties": false,
            "properties": {
              "backoff_seconds": {
                "minimum": 0,
                "type": "number"
              },
              "max_attempts": {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "max_attempts",
              "backoff_seconds"
            ],
            "type": "object"
          },
          "timeout": {
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "kind",
          "implementation_ref",
          "inputs",
          "outputs",
          "parameters",
          "environment_ref",
          "resource_request",
          "retry",
          "timeout",
          "cache_policy",
          "provenance"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\], -]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "permissions": {
      "type": "object"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "type": "string"
    },
    "recipe_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "type": "string"
    },
    "resources": {
      "items": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "revision"
            ]
          },
          {
            "required": [
              "sha256"
            ]
          }
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "dataset",
              "model",
              "checkpoint",
              "source",
              "artifact",
              "environment"
            ]
          },
          "license": {
            "minLength": 1,
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "private": {
            "type": "boolean"
          },
          "redistribution_allowed": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "revision": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "license"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "0"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "type": "string"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "maxItems": 1024,
          "type": "array"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "recipe_id",
    "project_id",
    "revision",
    "name",
    "source",
    "nodes",
    "edges",
    "resources",
    "environment",
    "evaluation",
    "outputs",
    "external_dependencies"
  ],
  "title": "ModelBuilder recipe v0",
  "type": "object"
}
