{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelbuilder.local/schemas/recipe.v0.schema.json",
  "title": "ModelBuilder recipe v0",
  "description": "A typed acyclic graph. Import is inert; execution requires separate authorization and isolation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 16384
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 1024
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "enum": [
              "dataset.import",
              "dataset.synthetic",
              "dataset.validate",
              "model.initialize",
              "model.train",
              "model.evaluate",
              "model.compare",
              "model.checkpoint",
              "model.export",
              "code.python",
              "training.kl_anchor"
            ]
          },
          "implementation_ref": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^builtin:[a-z][a-z_.]+$"
              },
              {
                "type": "object",
                "properties": {
                  "module": {
                    "type": "string",
                    "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*$"
                  },
                  "entrypoint": {
                    "type": "string",
                    "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)*$"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "module",
                  "entrypoint",
                  "commit"
                ],
                "additionalProperties": false,
                "dependentRequired": {
                  "path": [
                    "sha256"
                  ],
                  "sha256": [
                    "path"
                  ]
                }
              }
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\], -]{0,127}$"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\], -]{0,127}$"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "parameters": {
            "type": "object"
          },
          "parameter_schema": {
            "type": "object"
          },
          "environment_ref": {
            "type": "string",
            "minLength": 1
          },
          "resource_request": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "memory_mb": {
                "type": "integer",
                "minimum": 1
              },
              "gpu": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "retry": {
            "type": "object",
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "backoff_seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "max_attempts",
              "backoff_seconds"
            ],
            "additionalProperties": false
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cache_policy": {
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "provenance": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "implementation_ref",
          "inputs",
          "outputs",
          "parameters",
          "environment_ref",
          "resource_request",
          "retry",
          "timeout",
          "cache_policy",
          "provenance"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "source_port": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "target_node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "target_port": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "required": [
          "source_node",
          "source_port",
          "target_node",
          "target_port"
        ],
        "additionalProperties": false
      },
      "maxItems": 16384
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "enum": [
              "dataset",
              "model",
              "checkpoint",
              "source",
              "artifact",
              "environment"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "private": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "redistribution_allowed": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "license"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "revision"
            ]
          },
          {
            "required": [
              "sha256"
            ]
          }
        ]
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^3\\.\\d{1,2}(\\.\\d{1,2})?$"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lock_file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "oci_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "python",
        "requirements"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\], -]{0,127}$"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "enum": [
              "dataset",
              "model",
              "checkpoint",
              "source",
              "artifact",
              "environment"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "private": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "redistribution_allowed": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "license"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "revision"
            ]
          },
          {
            "required": [
              "sha256"
            ]
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "redistribution_allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "scope",
          "license",
          "redistribution_allowed"
        ],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "object"
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "recipe_id",
    "project_id",
    "revision",
    "name",
    "source",
    "nodes",
    "edges",
    "resources",
    "environment",
    "evaluation",
    "outputs",
    "external_dependencies"
  ],
  "additionalProperties": false
}
