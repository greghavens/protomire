{
  "$defs": {
    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Alias",
          "type": "string"
        },
        "bound_at": {
          "title": "Bound At",
          "type": "string"
        },
        "bound_by": {
          "title": "Bound By",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Id",
          "type": "string"
        },
        "trust_acknowledged": {
          "const": true,
          "title": "Trust Acknowledged",
          "type": "boolean"
        }
      },
      "required": [
        "alias",
        "repository_id",
        "bound_at",
        "bound_by",
        "trust_acknowledged"
      ],
      "title": "SourceBinding",
      "type": "object"
    },
    "TrackingConfig": {
      "additionalProperties": false,
      "properties": {
        "artifact_policy": {
          "default": "none",
          "enum": [
            "none",
            "metrics_snapshot"
          ],
          "title": "Artifact Policy",
          "type": "string"
        },
        "credential_env": {
          "const": "MODELBUILDER_WANDB_API_KEY",
          "default": "MODELBUILDER_WANDB_API_KEY",
          "title": "Credential Env",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "metric_names": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_./-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Metric Names",
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "offline",
            "online"
          ],
          "title": "Mode",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        }
      },
      "title": "TrackingConfig",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_model_version_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Model Version Ref"
    },
    "active_recipe_id": {
      "title": "Active Recipe Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "git_remote": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Remote"
    },
    "head_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Head Commit"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "model_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_migration": {
      "additionalProperties": true,
      "title": "Recipe Migration",
      "type": "object"
    },
    "research_watch_config": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Research Watch Config"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "0",
      "default": "0",
      "title": "Schema Version",
      "type": "string"
    },
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
      "title": "Slug",
      "type": "string"
    },
    "source_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "tracking": {
      "$ref": "#/$defs/TrackingConfig"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "id",
    "slug",
    "model_name",
    "created_at",
    "updated_at",
    "recipe_id",
    "active_recipe_id",
    "revision"
  ],
  "title": "ModelProject",
  "type": "object"
}
