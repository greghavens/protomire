{
  "operations": [
    {
      "description": "Browse authorized immutable private recipe metadata, outside the current workspace.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer"
          },
          "query": {
            "maxLength": 300,
            "type": "string"
          },
          "registry_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          },
          "tags": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "registry_id"
        ],
        "type": "object"
      },
      "mutating": false,
      "name": "recipe.discover",
      "operation": "recipe.discover",
      "required_scopes": [
        "read"
      ],
      "scope": "read"
    },
    {
      "description": "Import the exact reviewed private publication into one recipe/new project; trust and execution are separate.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "acknowledge_unresolved_dependencies": {
            "type": "boolean"
          },
          "confirm_import": {
            "const": true
          },
          "idempotency_key": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "publication_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "registry_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          },
          "review_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "target": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "expected_revision": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "mode": {
                    "const": "existing_project"
                  },
                  "project_id": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "mode",
                  "project_id",
                  "expected_revision"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "maxLength": 16000,
                    "type": "string"
                  },
                  "mode": {
                    "const": "new_project"
                  },
                  "model_name": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  "slug": {
                    "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
                    "type": "string"
                  }
                },
                "required": [
                  "mode",
                  "slug",
                  "model_name"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "registry_id",
          "publication_id",
          "target",
          "review_digest",
          "confirm_import",
          "idempotency_key"
        ],
        "type": "object"
      },
      "mutating": true,
      "name": "recipe.fork",
      "operation": "recipe.fork",
      "required_scopes": [
        "modify",
        "read"
      ],
      "scope": "modify"
    },
