          "package_version": {
            "maxLength": 100,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[a-zA-Z0-9]+(?:[.-][a-zA-Z0-9]+)*)?$",
            "type": "string"
          },
          "project_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "recipe_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "registry_id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          },
          "review_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "visibility": {
            "const": "private"
          }
        },
        "required": [
          "registry_id",
          "project_id",
          "recipe_id",
          "expected_revision",
          "package_name",
          "package_version",
          "visibility",
          "metadata",
